# Use your domain with an A record pointing to your Linux VPS.
SIGNAL_DOMAIN=

# Optional TURN profile. These are intentionally blank: no shared default secrets.
TURN_DOMAIN=
# IPv4, or PUBLIC_IPV4/PRIVATE_IPV4 when the VPS is behind one-to-one NAT.
TURN_EXTERNAL_IP=
# The IPv4 address actually assigned to the VPS network interface.
TURN_RELAY_IP=
TURN_USERNAME=
# Generate a fresh 64-character hex password: openssl rand -hex 32
TURN_PASSWORD=
# Set to 1 only after placing fullchain.pem and privkey.pem in deploy/turn-certs.
TURN_TLS=0
